# Copie este arquivo para .env na raiz do projeto:
# PowerShell: Copy-Item .env.exemple .env
# Substitua os valores abaixo antes de executar a aplicação.

# --- OpenAI ---
# Chave de API da sua conta. Preencha apenas no .env local.
CHATGPT_SDK_KEY=

# Identificador de um modelo compatível com entrada de PDF e JSON Schema.
MODEL_OPENAI=

# --- Diretórios ---
# Use caminhos absolutos, sem barra final, e crie a pasta de entrada.
# Mantenha entrada e saída em pastas distintas; a saída é criada automaticamente.
# O volume de saída deve permitir hard links (por exemplo, NTFS).
# No Windows, use barras invertidas simples, como nos exemplos abaixo.

# Pasta monitorada: somente PDFs na raiz são processados; subpastas são ignoradas.
FILE_PATH_BASE=

# Pasta de saída: os PDFs são movidos para subpastas por categoria.
DIR_PATH_BASE=

# true: envia para revisao/categoria até aprovação pelo terminal.
# false: organiza diretamente na categoria sugerida pela IA.
REVIEW_REQUIRED=true
